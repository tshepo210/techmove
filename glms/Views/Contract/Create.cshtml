@model glms.Models.Entities.Contract

<h2>Create Contract</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <select asp-for="ClientId" class="form-control">
        @foreach (var client in ViewBag.Clients)
        {
            <option value="@client.Id">@client.Name</option>
        }
    </select>

    <input asp-for="StartDate" type="date" class="form-control mt-2" />
    <input asp-for="EndDate" type="date" class="form-control mt-2" />

    <select asp-for="Status" class="form-control mt-2">
        <option>Draft</option>
        <option>Active</option>
        <option>Expired</option>
        <option>On Hold</option>
    </select>

    <input asp-for="ServiceLevel" class="form-control mt-2" placeholder="Service Level" />

    <input type="file" name="file" class="form-control mt-2" />

    <button class="btn btn-success mt-3">Save</button>
</form>
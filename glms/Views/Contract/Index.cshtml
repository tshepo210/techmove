@model IEnumerable<glms.Models.Entities.Contract>

<h2>Contracts</h2>

<a asp-action="Create" class="btn btn-primary">New Contract</a>

<form method="get" class="mt-2">

    <select name="status" class="form-control">
        <option value="">All Statuses</option>
        <option value="Draft" selected="@(Context.Request.Query["status"] == "Draft")">Draft</option>
        <option value="Active" selected="@(Context.Request.Query["status"] == "Active")">Active</option>
        <option value="Expired" selected="@(Context.Request.Query["status"] == "Expired")">Expired</option>
        <option value="On Hold" selected="@(Context.Request.Query["status"] == "On Hold")">On Hold</option>
    </select>

    <input type="date" name="startDate" class="form-control mt-2"
           value="@Context.Request.Query["startDate"]" />

    <input type="date" name="endDate" class="form-control mt-2"
           value="@Context.Request.Query["endDate"]" />

    <button class="btn btn-info mt-2">Filter</button>
</form>

<table class="table mt-3">
    <tr>
        <th>Client</th>
        <th>Status</th>
        <th>Dates</th>
        <th>File</th>
    </tr>

    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Client.Name</td>
            <td>@c.Status</td>
            <td>@c.StartDate.ToShortDateString() - @c.EndDate.ToShortDateString()</td>
            <td>
                @if (c.FilePath != null)
                {
                    <a href="@c.FilePath">Download</a>
                }
            </td>
        </tr>
    }
</table>
@model IEnumerable<glms.Models.Entities.ServiceRequest>

<h2>Service Requests</h2>

<a asp-action="Create" class="btn btn-primary">New Request</a>

<table class="table mt-3">
    <tr>
        <th>Client</th>
        <th>Contract</th>
        <th>Description</th>
        <th>Status</th>
        <th>Cost</th>
        <th>Converted (ZAR)</th>
    </tr>

    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Contract.Client.Name</td>
            <td>@r.ContractId</td>
            <td>@r.Description</td>
            <td>@r.Status</td>
            <td>@r.Cost @r.Currency</td>
            <td>@r.ConvertedCost.ToString("0.00")</td>
        </tr>
    }
</table>